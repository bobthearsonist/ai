# Worktrees
.worktrees/

# External skills cache
.external-cache/

# Build output
dist/

# Memory
memory/memory.jsonl
memory/backups/

# Local config
local.yaml

# Synced collections (use git add -f for shared items). sync.sh materializes
# skills/, agents/ and hooks/ from the collections in local.yaml — see
# docs/collections.md. Contents are symlinks into ai-private/profisee-ai.
skills/
agents/
hooks/

# Synced config directory — entire claude/ is a sync.sh-managed symlink to ai-private.
# No trailing slash so the gitignore rule matches the symlink itself (git treats
# a symlink-to-directory as a file entry, not a directory entry).
claude

# graphify per-repo graph artifacts (built locally, not source-controlled)
graphify-out/

# Timestamped hand-rolled backups (*.bak-YYYYMMDD) — a recurring local habit,
# never source. Delete when the forensics are done.
*.bak-*
