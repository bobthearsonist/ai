# Local AI Configuration Template
#
# Copy this to local.yaml and customize for your machine.
# local.yaml is gitignored - do not commit it.

# Skill and agent collections map local source repos into this repo's shared
# skills/ and agents/ output directories.
#
# `path` points to the source repo root. By default, skills are found at
# {path}/skills/{name} and agents at {path}/agents/{name}.
# Override with `skills_dir` or `agents_dir` for different layouts.
#
# Items can be:
#   - A string: source dir name = symlink name
#   - An object with `source` and `name` when they differ
#
# Collections whose path does not exist are skipped, so you can keep personal
# and work collections in the same local.yaml across machines.
#
# Private-access or machine-specific skills belong here, never in the shared,
# public external-skills.yaml.

collections:
  # Keep legacy client paths on the manifest-managed skill-creator.
  toolkit:
    path: ~/AI
    links:
      - source: skills/skill-creator
        target: ~/AI/skills/domain/ai/skill-creator
      # Copilot CLI extension that feeds live MCP status to the statusline.
      - source: copilot/extensions/mcp-status
        target: ~/.copilot/extensions/mcp-status

  # Personal collection - your private reusable skills repo.
  personal:
    path: ~/Repositories/my-ai-skills
    skills:
      - my-skill
      - another-skill
      # - source: reviewer
      #   name: code-review
    agents:
      - my-agent.md
    hooks:
      - my-hook.sh

    # `links:` exposes non-skill content from the collection.
    #
    # `target` must be absolute or ~-prefixed.
    # `source` is normally relative to `path` (the collection repo root);
    # a source starting with `/` or `~` is taken verbatim, which lets a
    # link CHAIN through another already-declared symlink rather than
    # pointing straight at the collection repo.
    #
    # For actively-written config files (e.g. Claude Code's settings.json),
    # prefer a directory symlink one layer up so atomic-write-rename lands
    # inside the symlinked directory and the symlinks above it survive.
    # Read-only scripts can use a direct file symlink without this concern.
    links:
      # === Example: Claude Code settings chain ===
      # 1. Directory symlink so ai/claude/ resolves to the collection's
      #    claude/ directory.
      # - source: claude
      #   target: ~/Repositories/ai/claude
      # 2. File symlink chained through ai/claude/ (absolute source path).
      #    Atomic writes by Claude Code rename inside the resolved
      #    directory, leaving both symlinks above it intact.
      # - source: ~/Repositories/ai/claude/settings.json
      #   target: ~/.claude/settings.json
      # === Example: read-only scripts referenced from settings.json ===
      # statusLine.command and hook commands are paths, not payloads —
      # symlinking them here means peer machines that run sync.sh get
      # the same scripts available at the same well-known paths.
      # - source: claude/statusline.sh
      #   target: ~/.claude/statusline.sh

  # Flat repo example - skills live directly under the repo root.
  # flat-skills:
  #   path: ~/Repositories/my-flat-skills
  #   skills_dir: ""
  #   skills:
  #     - code-review

  # Work collection - uncomment on work machines.
  # work:
  #   path: ~/Repositories/company-ai
  #   skills:
  #     - company-api
  #     - source: dotnet
  #       name: company-dotnet
  #     # One item that a plugin under `plugins:` also ships.
  #     # CONSUMED: scripts/sync.sh reads .collections.<name>.<skills|agents>[].plugin
  #     - source: incident-response
  #       plugin: incident-response
  #   agents:
  #     - company-agent.md

  # Published collection - a detached worktree that each sync moves to `ref`,
  # so every client sees merged skills rather than your working branch.
  # See docs/collections.md#published-skills.
  # work_published:
  #   path: ~/Repositories/company-ai-published
  #   ref: origin/main
  #   skills:
  #     - incident-response

  # Plugin collection - a repo whose skills and agents also ship inside a
  # Claude-format plugin. `plugin` names an entry under `plugins:` below. When
  # that entry exists on this machine, Claude Code and Copilot CLI get these
  # items from the plugin, so sync.sh leaves them out of skills-without-plugins/
  # and agents-without-plugins/. Clients without plugin support (OpenCode) still
  # get them through skills/ and agents/. See docs/plugins.md.
  # CONSUMED: scripts/sync.sh reads .collections.<name>.plugin
  # my_plugin_repo:
  #   path: ~/Repositories/my-plugin
  #   plugin: my-plugin
  #   skills:
  #     - my-plugin-skill
  #   agents:
  #     - my-plugin-agent.md

# Which copy of each Claude-format plugin Claude Code and Copilot CLI load on
# this machine. `dev` loads your working copy in place from a local marketplace,
# so edits reach the next session without publishing. `published` installs it
# from its own marketplace. The copy not chosen is disabled, because both
# clients let a plugin shadow a same-named one. Apply changes with
# ./scripts/plugins.sh. See docs/plugins.md.

dev_marketplace:
  # CONSUMED: scripts/plugins.sh writes <root>/.claude-plugin/marketplace.json
  # listing every plugin under `plugins:` that has a `path`, and registers it
  # with both clients. root must contain each plugin's folder: both clients
  # skip symlinks that point outside a local marketplace.
  name: local
  root: /path/to/repositories

plugins:
  # CONSUMED: scripts/plugins.sh reads mode, path, marketplace and
  # marketplace_source. scripts/sync.sh reads which plugins are listed.
  my-plugin:
    mode: dev                     # dev | published
    path: my-plugin               # working copy, relative to dev_marketplace.root
    marketplace: my-marketplace   # where the published copy comes from
  # A third-party plugin you only install published.
  # obsidian:
  #   mode: published
  #   marketplace: obsidian-skills
  #   marketplace_source: obsidianmd/obsidian-skills   # added when not registered

# Optional machine context used by some skills/prompts. sync.sh does not require
# any of these. Keys marked CONSUMED are read by tooling - the rest are
# reference material for agents and humans.

work:
  name: YourCompany
  # CONSUMED: substituted for {{ADO_ORG}} in permissions/permissions.yaml
  ado_org: yourcompany
  skills_path: /path/to/yourcompany-ai/skills/
  repositories_root: /path/to/repositories/

paths:
  home: /Users/YourUsername

repos:
  # CONSUMED: ai-infrastructure/mcps/qdrant-mcp/indexer/run.sh line 14 reads
  # .repos.base_path into REPOS_BASE when indexing source repositories.
  base_path: /path/to/repositories

obsidian:
  # Root folder that holds EVERY vault on this machine. Each vault is a folder
  # directly under it containing .obsidian/. Skills resolve vaults through
  # skills/obsidian-notes/scripts/vault.sh - never hardcode a vault path.
  # (Legacy: with no default_vault, vault_path is treated as the vault itself.)
  vault_path: /path/to/Obsidian

  # Vault used when a context doesn't name one. CONSUMED: the qdrant indexer's
  # run.sh exports vault_path/default_vault as VAULT_PATH. Only folders named
  # under contexts: are indexed - the rest of the vault is deliberately left out.
  # CONSUMED: the visual-notes agent plugin's hook reads vault_path,
  # default_vault and contexts when the visual-notes Obsidian plugin's "Agent
  # config file" setting points at this file; it conforms sidecars only in
  # those folders.
  default_vault: Main

  # User-defined contexts. Keys are free-form names you choose to match
  # how you mentally separate your notes (some users have one, others
  # have several). Agents enumerate these via
  # skills/obsidian-notes/scripts/context.sh and ask which to use when
  # it can't be inferred from session context. The shape mirrors the
  # daily-context Obsidian plugin's data.json so both stay in sync.
  contexts:
    default:
      # vault: Main            # optional per-context vault, defaults to default_vault
      daily_folder: 0 Daily Notes
      ai_session_folders:
        - 0 AI Sessions
      # Optional project hub conventions. CONSUMED: the obsidian-notes skill reads
      # them through context.sh (hubs.* lines); a context without hubs has none.
      # hubs:
      #   folder: Projects
      #   type: hub                                  # frontmatter type that marks a hub
      #   template: Templates/HubHeadless.md         # optional headless Templater template
      #   args_global: __hubArgs                     # window property that template reads
      #   work_item_field: state                     # optional, mirrored from a work tracker
      #   status_field: status
      #   statuses: [active, planning, paused, complete, archived]   # first is the default

graphify:
  # Structural code-graph topology for this machine. Reference only - no script
  # reads these keys today, but this is the only place the workspace layout is
  # written down. Full guide: ai-infrastructure/docs/graphify-workspace-setup.md
  #
  # graphify scans scan_root subject to .graphifyignore at that same root. That
  # ignore file is the source-of-truth allowlist for which repos are in scope,
  # so worktrees and vendored trees are excluded there, not here.
  scan_root: /path/to/repositories

  # Graph artifacts (graph.json, GRAPH_REPORT.md) land here rather than in the
  # source tree. graphify always writes to a cwd-relative graphify-out/, so
  # scan_root/graphify-out is a link pointing at this directory.
  output_dir: /path/to/graphify-out
