{
  "checks": [
    {
      "pattern": "^[\\s`]*(feat|fix|chore|refactor|docs|test|ci|style|perf|build|revert)(\\([^)]+\\))?!?: [a-z]",
      "flags": "m",
      "type": "regex",
      "name": "conventional-header"
    },
    {
      "pattern": "(\\)|[a-z])!: |BREAKING CHANGE",
      "flags": "",
      "type": "regex",
      "name": "breaking-marker"
    }
  ],
  "prompt": "We dropped Node 14 support. Give me the commit line.",
  "id": "implicit-breaking",
  "shouldTrigger": true
}
