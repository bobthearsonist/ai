{
  "prompt": "Draft a one-line commit message for adding a setup guide to the docs folder. Just the message, nothing else.",
  "id": "confusable-commit-draft",
  "shouldTrigger": false,
  "fixtures": false,
  "checks": [
    {
      "flags": "i",
      "name": "message",
      "type": "regex",
      "pattern": "docs: add setup guide"
    },
    {
      "flags": "i",
      "name": "no-registry-advice",
      "type": "not_regex",
      "pattern": "collections\\.private"
    },
    {
      "flags": "i",
      "name": "no-command",
      "type": "not_regex",
      "pattern": "git commit"
    }
  ]
}
